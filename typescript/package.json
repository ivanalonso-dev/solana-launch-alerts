{
  "name": "solana-launch-alerts",
  "version": "1.0.0",
  "description": "Verify and parse signed launch-risk alert webhooks for Solana launchpads (open standard, spec 2026-10).",
  "license": "MIT",
  "author": "Ivan Alonso (EMERGE)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {"node": ">=18"},
  "keywords": ["solana", "webhook", "hmac", "security", "launchpad", "alerts"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/sdk.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
